{
  "name": "musicplayer",
  "version": "1.0.0",
  "description": "Django Music Player Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
  "appId": "com.musicplayer.app",
  "productName": "MusicPlayer",
  "directories": {
    "output": "release"
  },
  "files": [
    "**/*"
  ],
  "extraResources": [
    {
      "from": "../dist/musicplayer-server",
      "to": "django-server"
    },
    {
      "from": "../media",
      "to": "media"
    },
    {
      "from": "../db.sqlite3",
      "to": "db.sqlite3"
    }
  ],
  "win": {
    "target": "nsis"
  }
}
}